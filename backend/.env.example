ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://agent:agent@postgres:5432/agent_gns3

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dev-token
INFLUXDB_ORG=agent-org
INFLUXDB_BUCKET=network_metrics

GNS3_URL=http://host.docker.internal:3080
GNS3_USER=admin
GNS3_PASSWORD=admin
GNS3_PROJECT_ID=

LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

DEVICE_SSH_USERNAME=admin
DEVICE_SSH_PASSWORD=admin
DEVICE_SSH_SECRET=
DEVICE_DEFAULT_TYPE=cisco_ios

# Syslog UDP listener cho lớp An ninh (mục 3.3.1, 3.3.4) - cấu hình thiết bị Cisco IOS
# trong lab đẩy syslog tới: `logging host <IP_agent_server> transport udp port 5514`
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=5514
# ID thiết bị biên (ví dụ R1) dùng để chặn IP khi phát hiện tấn công qua syslog.
SECURITY_EDGE_DEVICE_ID=

SECRET_KEY=change-me-in-production
