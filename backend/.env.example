ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://agent:agent@postgres:5432/agent_gns3

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dev-token
INFLUXDB_ORG=agent-org
INFLUXDB_BUCKET=network_metrics

GNS3_URL=http://host.docker.internal:3080
