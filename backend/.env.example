GNS3_PASSWORD=admin
GNS3_PROJECT_ID=

LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

DEVICE_SSH_USERNAME=admin
DEVICE_SSH_PASSWORD=admin
DEVICE_SSH_SECRET=
DEVICE_DEFAULT_TYPE=cisco_ios

SECRET_KEY=change-me-in-production
